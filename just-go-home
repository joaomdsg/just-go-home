from datetime import datetime, time, timedelta
from pathlib import Path

CONFIG_DIR = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "just-go-home"
)
CONFIG_FILE = CONFIG_DIR / "config.toml"
CACHE_DIR = (
    Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "just-go-home"
)
STATE_FILE = CACHE_DIR / "state.json"
LOCK_FILE = CACHE_DIR / "state.lock"

DAY_MAP = {"mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6}
NOTIFY_OFFSETS = [3600, 1800, 900, 300, 60, 30]
POSTPONE_LOCK_SECS = 90
DRY_RUN = os.environ.get("JGH_DRY_RUN") == "1"


def safe_run(cmd, **kwargs):
    """subprocess.run that returns None if the binary is missing or any OSError occurs."""
    kwargs.setdefault("check", False)
    try:
        return subprocess.run(cmd, **kwargs)
    except (FileNotFoundError, PermissionError, OSError):
        return None


@contextlib.contextmanager
def state_lock():
    """Cross-process advisory lock around state.json read-modify-write.

    Why: tick runs every 1s; postpone runs interactively. Without locking,
    postpone's `postpone_lock_until` can be clobbered by an interleaved tick.
    """
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError:
        yield
        return
    try:
        f = open(LOCK_FILE, "w")
    except OSError:
        yield
        return
    try:
        try:
            fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        except OSError:
            pass
        yield
    finally:
        try:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        f.close()


def load_config():
    """Returns (config_dict, error_message). Both None if file is absent."""
    if not CONFIG_FILE.exists():
        return None, None
    try:
        with open(CONFIG_FILE, "rb") as f:
            cfg = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        return None, f"config: invalid TOML — {e}"
    except OSError as e:
        return None, f"config: {e}"
    if not isinstance(cfg, dict):
        return None, "config: top-level must be a table"
    return cfg, None


def load_state():
    if not STATE_FILE.exists():
        return {}
    try:
        with open(STATE_FILE) as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}
    if not isinstance(data, dict):
        return {}
    return data


def save_state(state):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = STATE_FILE.with_suffix(f".json.{os.getpid()}.tmp")
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATE_FILE)
    except OSError:
        # Cache dir unwritable / disk full — widget keeps running with in-memory state.
        pass


def _parse_target_spec(spec):
    """Returns (days_set, hour, minute) or None if the spec is malformed."""
    if not isinstance(spec, dict):
        return None
    raw_days = spec.get("days")
    raw_time = spec.get("time")
    if not isinstance(raw_days, list) or not raw_days or not isinstance(raw_time, str):
        return None
    days = set()
    for d in raw_days:
        if not isinstance(d, str):
            return None
        idx = DAY_MAP.get(d.lower().strip())
        if idx is None:
            return None
        days.add(idx)
    parts = raw_time.split(":")
    if len(parts) != 2:
        return None
    try:
        h = int(parts[0])
        m = int(parts[1])
    except ValueError:
        return None
    if not (0 <= h <= 23 and 0 <= m <= 59):
        return None
    return days, h, m


def next_scheduled(config, now):
    candidates = []
    for spec in config.get("targets", []) or []:
        parsed = _parse_target_spec(spec)
        if parsed is None:
            continue
        days, h, m = parsed
        for offset in range(0, 8):
            d = (now + timedelta(days=offset)).date()
            if d.weekday() in days:
                try:
                    cand = datetime.combine(d, time(h, m))
                except ValueError:
                    break
                if cand > now:
                    candidates.append(cand)
                    break
    return min(candidates) if candidates else None


def get_target(config, state, now):
    override = state.get("target_override")
    if isinstance(override, str):
        try:
            ov = datetime.fromisoformat(override)
            if ov > now or state.get("preview"):
                return ov
        except ValueError:
            pass
    return next_scheduled(config, now)


def _sanitize_fired(fired):
    if not isinstance(fired, list):
        return []
    out = []
    for v in fired:
        try:
            out.append(str(int(v)))
        except (TypeError, ValueError):
            continue
    return sorted(set(out), key=int)


def reconcile(state, target):
    key = target.isoformat() if target else None
    if state.get("target_key") != key:
        state["target_key"] = key
        state["fired"] = []
        state["last_eta"] = None
        state["last_tick"] = None
        state["final_notif_at"] = None
    state["fired"] = _sanitize_fired(state.get("fired"))
    return state


def classify(eta):
    if eta <= 0:
        return "shutdown"
    if eta <= 60:
        return "flashing"
    if eta <= 300:
        return "urgent"
    if eta <= 1800:
        return "warning"
    if eta <= 3600:
        return "warm"
    return "calm"


def eta_part(eta):
    """Return (n, unit_word) for the largest natural unit, ceiling-rounded."""
    if eta >= 3600:
        n = -(-eta // 3600)
        return n, "hour" if n == 1 else "hours"
    if eta >= 60:
        n = -(-eta // 60)
        return n, "minute" if n == 1 else "minutes"
    return eta, "second" if eta == 1 else "seconds"


def fmt_eta_pango(eta):
    if eta <= 0:
        return "<span weight='heavy' size='medium'>GO HOME</span>"
    n, word = eta_part(eta)
    return (
        f"<span weight='heavy' size='medium'>Shutdown</span>"
        f"<span weight='ultralight' size='medium'> in </span>"
        f"<span weight='heavy' size='medium'>{n}</span>"
        f"<span weight='ultralight' size='medium'> {word}</span>"
    )


def fmt_eta_plain(eta):
    if eta <= 0:
        return "GO HOME"
    n, word = eta_part(eta)
    return f"{n} {word}"


