def main():
    p = argparse.ArgumentParser(
        prog="just-go-home", description="end-of-workday enforcer"
    )
    sub = p.add_subparsers(dest="cmd", required=True)
    tick_p = sub.add_parser("tick", help="emit one waybar JSON line")
    tick_p.add_argument("--loop", action="store_true", help="stream JSON every second")
    sub.add_parser("postpone", help="run rotating-phrase override")
    sub.add_parser("status", help="print current target and eta")
    sub.add_parser("init", help="create example config and print waybar snippet")
    args = p.parse_args()
    if args.cmd == "tick":
        cmd_tick(loop=args.loop)
    elif args.cmd == "postpone":
        cmd_postpone()
    elif args.cmd == "status":
        cmd_status()
    elif args.cmd == "init":
        cmd_init()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
