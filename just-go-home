def cmd_init():
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(EXAMPLE_CONFIG)
        print(f"wrote example config: {CONFIG_FILE}")
    else:
        print(f"config exists: {CONFIG_FILE}")
    print()
    print("add to ~/.config/waybar/config.jsonc (inside the modules object):")
    print(WAYBAR_SNIPPET)
    print("add to ~/.config/waybar/style.css:")
    print(STYLE_SNIPPET)
    print(
        'then add "custom/just-go-home" to your modules-right (or -left/-center) array,'
    )
    print("and restart waybar.")


def main():
    p = argparse.ArgumentParser(
        prog="just-go-home", description="end-of-workday enforcer"
    )
    sub = p.add_subparsers(dest="cmd", required=True)
    tick_p = sub.add_parser("tick", help="emit one waybar JSON line")
    tick_p.add_argument("--loop", action="store_true", help="stream JSON every second")
    sub.add_parser("postpone", help="run rotating-phrase override")
    sub.add_parser("status", help="print current target and eta")
    sub.add_parser("init", help="create example config and print waybar snippet")
    args = p.parse_args()
    if args.cmd == "tick":
        cmd_tick(loop=args.loop)
    elif args.cmd == "postpone":
        cmd_postpone()
    elif args.cmd == "status":
        cmd_status()
    elif args.cmd == "init":
        cmd_init()


if __name__ == "__main__":
    main()
